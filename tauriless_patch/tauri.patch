index ea93715344c0107ec1a0ea8e00d259170f033667..7e0a9e7ba1c283cd28633ea94acb4ffaaf599bdb 100644
--- a/crates/tauri/src/app.rs
+++ b/crates/tauri/src/app.rs
@@ -1483,6 +1483,32 @@ impl<R: Runtime> App<R> {
   }
 }
 
+#[cfg(all(desktop, feature = "wry"))]
+impl App<crate::Wry> {
+  /// Runs the native event loop until it becomes idle, waiting at most `timeout` for work.
+  pub fn run_timeout<F: FnMut(&AppHandle<crate::Wry>, RunEvent) + 'static>(
+    &mut self,
+    timeout: Duration,
+    mut callback: F,
+  ) -> i32 {
+    let manager = self.manager.clone();
+    let app_handle = self.handle().clone();
+
+    if !self.ran_setup {
+      if let Err(e) = setup(self) {
+        panic!("Failed to setup app: {e}");
+      }
+    }
+
+    app_handle.event_loop.lock().unwrap().main_thread_id = std::thread::current().id();
+
+    self.runtime.as_mut().unwrap().run_timeout(timeout, move |event| {
+      let event = on_event_loop_event(&app_handle, event, &manager);
+      callback(&app_handle, event);
+    })
+  }
+}
