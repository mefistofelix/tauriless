new file mode 100644
index 0000000000000000000000000000000000000000..49391a38cd7cd85c9e6b0e88847c7eb1798659f2
--- /dev/null
+++ b/examples/run_timeout_probe.rs
@@ -0,0 +1,59 @@
+use std::{
+  thread,
+  time::{Duration, Instant},
+};
+use tao::{
+  event::Event,
+  event_loop::{ControlFlow, EventLoopBuilder},
+};
+
+fn run_timeout(event_loop: &mut tao::event_loop::EventLoop<()>, timeout: Duration) -> Duration {
+  let start = Instant::now();
+  event_loop.run_timeout(timeout, |_, _, control_flow| {
+    *control_flow = ControlFlow::Wait;
+  });
+  start.elapsed()
+}
+
+fn main() {
+  let mut event_loop = EventLoopBuilder::<()>::with_user_event().build();
+
+  let bootstrap = run_timeout(&mut event_loop, Duration::from_millis(50));
+  println!("bootstrap: {} ms", bootstrap.as_millis());
+
+  let elapsed = run_timeout(&mut event_loop, Duration::from_millis(50));
+  println!("warm-up: {} ms", elapsed.as_millis());
+  assert!(elapsed < Duration::from_millis(500));
+
+  for i in 1..=3 {
+    let elapsed = run_timeout(&mut event_loop, Duration::from_millis(50));
+    println!("timeout {i}: {} ms", elapsed.as_millis());
+    assert!(elapsed >= Duration::from_millis(35));
+    assert!(elapsed < Duration::from_millis(500));
+  }
+
+  let proxy = event_loop.create_proxy();
+  thread::spawn(move || {
+    thread::sleep(Duration::from_millis(25));
+    proxy.send_event(()).unwrap();
+  });
+
+  let start = Instant::now();
+  let mut received = false;
+  event_loop.run_timeout(Duration::from_millis(500), |event, _, control_flow| {
+    *control_flow = ControlFlow::Wait;
+    if matches!(event, Event::UserEvent(())) {
+      received = true;
+    }
+  });
+  let elapsed = start.elapsed();
+  println!("native wake: {} ms", elapsed.as_millis());
+  assert!(received);
+  assert!(elapsed >= Duration::from_millis(10));
+  assert!(elapsed < Duration::from_millis(300));
+
+  let elapsed = run_timeout(&mut event_loop, Duration::from_millis(50));
+  println!("post-wake timeout: {} ms", elapsed.as_millis());
+  assert!(elapsed >= Duration::from_millis(35));
+  assert!(elapsed < Duration::from_millis(500));
+}
