+#[cfg(all(desktop, feature = "wry"))]
+impl App<crate::Wry> {
+  /// Runs the native event loop until it becomes idle, waiting at most `timeout` for work.
+  pub fn run_for<F: FnMut(&AppHandle<crate::Wry>, RunEvent) + 'static>(
+    &mut self,
+    timeout: Duration,
+    mut callback: F,
+  ) -> i32 {
+    let manager = self.manager.clone();
+    let app_handle = self.handle().clone();
+
+    if !self.ran_setup {
+      if let Err(e) = setup(self) {
+        panic!("Failed to setup app: {e}");
+      }
+    }
+
+    app_handle.event_loop.lock().unwrap().main_thread_id = std::thread::current().id();
+
+    self.runtime.as_mut().unwrap().run_for(timeout, move |event| {
+      let event = on_event_loop_event(&app_handle, event, &manager);
+      callback(&app_handle, event);
+    })
+  }
+}
